#!/usr/bin/env bash
# Pre-commit gate: nothing that fails lint gets committed.
#
# Runs `bin/verify --fast` (black, ruff, JS parse on every served page, contrast):
# seconds, so committing stays cheap. The tests and both eval gates run in CI on every
# PR; the full `bin/verify` (adds pytest, the desktop Rust tests and the Android
# compile check CI does not cover) is run by hand before merging a desktop or mobile
# change. A failure blocks the commit.
#
# Install (once per clone):   git config core.hooksPath .githooks
# Emergency bypass (avoid):   git commit --no-verify
#
# It only runs when code that bin/verify covers is staged, so docs-only commits stay
# instant.

set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# What is staged for this commit?
staged="$(git diff --cached --name-only --diff-filter=ACM)"

# Docs/asset-only commits do not need the code gate.
if ! printf '%s\n' "$staged" | grep -qE '\.(py|js|html|rs|toml)$|^bin/|^desktop/(src|permissions|Cargo)'; then
  exit 0
fi

echo "pre-commit: running bin/verify --fast (code changes staged)..."
if ! "$REPO/bin/verify" --fast; then
  echo >&2
  echo "pre-commit: bin/verify --fast FAILED - commit blocked." >&2
  echo "pre-commit: fix it, or 'git commit --no-verify' only if you truly must." >&2
  exit 1
fi
echo "pre-commit: bin/verify --fast green - committing."
