#!/usr/bin/env bash
# Restart Enqueue: engine, then the macOS window, then bring it to the front.
#
# The shell owns the engine's lifetime, so restarting the engine alone leaves the
# window pointing at a dead port, and killing the window takes the engine with it.
# They come up together or not at all, which is what this exists to guarantee.
#
#   bin/relaunch          restart both
#   bin/relaunch --build  rebuild the shell first (after editing desktop/src)

set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BIN="$REPO/desktop/target/debug/enqueue-desktop"
LOG="${TMPDIR:-/tmp}/enqueue-app.log"

if [[ "${1:-}" == "--build" ]]; then
  echo "building the shell..."
  (cd "$REPO/desktop" && cargo build)
fi

# The shell kills its own engine when the window closes, so stop the window first
# and let it clean up rather than orphaning a process on the port.
pkill -f "enqueue-desktop" 2>/dev/null || true
sleep 1
pkill -f "enq serve" 2>/dev/null || true
sleep 1

if [[ ! -x "$BIN" ]]; then
  echo "no shell built yet. run: bin/relaunch --build" >&2
  exit 1
fi

# The interface is inline <script>. A single stray quote takes out every function at
# once, and the page still serves 200 with no console error the harness can see, so it
# looks like a behaviour bug rather than a parse failure. Cheap to check, expensive to
# miss. Since M.8 the home page's JS lives in static/js/*.js (loaded by <script src>),
# so home is checked as one concatenation - separate classic scripts share the global
# scope, and the concatenation also catches a top-level name redeclared across files;
# capture still carries its JS inline, so every block in every served page is checked,
# because the overlay has more than one and a gate that checks only the first stops
# being a gate the moment someone adds a second.
if command -v node >/dev/null 2>&1; then
  for page in home capture; do
    # The suffix matters: node infers module type from the extension and refuses a
    # bare temp name.
    JS="$(mktemp -t enqueue-js).js"
    if [[ "$page" == "home" ]]; then
      cat "$REPO"/src/enqueue/static/js/{util,icons,md,dialogs,pill,morph,home,artifact,search,pivot,chat,trash,settings}.js > "$JS"
    else
      python3 - "$REPO/src/enqueue/static/$page.html" "$JS" <<'PY'
import re
import sys

src = open(sys.argv[1], encoding="utf-8").read()
blocks = re.findall(r"<script[^>]*>(.*?)</script>", src, re.S)
if not blocks:
    sys.exit("no script found in " + sys.argv[1])
# Wrapped so a `const` in one block cannot collide with the same name in another.
open(sys.argv[2], "w", encoding="utf-8").write(
    "\n".join("{\n" + b + "\n}" for b in blocks)
)
PY
    fi
    if ! node --check "$JS"; then
      echo "$page.html does not parse. not launching." >&2
      rm -f "$JS"
      exit 1
    fi
    rm -f "$JS"
  done
fi

echo "/Users/minhmai/enqueue" > "$HOME/.enqueue-poc/repo" 2>/dev/null || true

ENQUEUE_REPO="$REPO" "$BIN" >"$LOG" 2>&1 &

# The window is only useful once the engine behind it answers.
for _ in $(seq 1 40); do
  if curl -sf -o /dev/null http://127.0.0.1:8787/health; then break; fi
  sleep 0.5
done

if ! curl -sf -o /dev/null http://127.0.0.1:8787/health; then
  echo "engine never came up. log:" >&2
  tail -20 "$LOG" >&2
  exit 1
fi

# Launched from a shell, the process is not frontmost, so the window opens behind
# whatever the person was looking at and reads as a launch that failed.
osascript -e 'tell application "System Events" to tell process "enqueue-desktop" to set frontmost to true' 2>/dev/null || true

echo "up: $(curl -s http://127.0.0.1:8787/health)"
echo "log: $LOG"
