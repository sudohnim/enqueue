#!/usr/bin/env bash
# Build Enqueue's distributable artifacts for a chosen platform.
#
#   bin/release desktop         self-contained macOS .app + .dmg (engine vendored inside)
#   bin/release android         signed release .apk + .aab
#
# Sibling to bin/launch, not a mode of it: `launch` runs the app for development (restarts
# processes, fronts a window, exits leaving nothing or a running app); `release` produces
# shippable artifacts and exits. Different intent, different side effects - kept apart on
# purpose.
#
# desktop: vendors a relocatable Python engine into the bundle (bin/bundle-engine), then
# `cargo tauri build` with the release overlay so the engine ships inside Enqueue.app.
# The result runs on a clean Mac with no repo, no uv, no system Python. UNSIGNED - fine
# for dogfooding (right-click -> Open the first time); a public release also needs an
# Apple Developer ID cert + notarization wired through Tauri's signing env vars.
#
# android: a RELEASE build (no --debug) - loads the embedded frontend and is signed with
# desktop/gen/android/key.properties (+ release.keystore), or the matching RELEASE_* env
# vars. See that file's header to create the keystore the first time.

set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

usage() {
  echo "usage: bin/release <desktop|android>" >&2
  exit 2
}

release_desktop() {
  echo "==> Vendoring the engine into the app bundle"
  "$REPO/bin/bundle-engine"

  # Signing + notarization is opt-in: set APPLE_SIGNING_IDENTITY (a "Developer ID
  # Application: ..." identity in the keychain) to sign, and APPLE_ID + APPLE_PASSWORD +
  # APPLE_TEAM_ID (or APPLE_API_KEY/_ISSUER/_KEY_PATH) for Tauri to notarize during build.
  # With none set, the build is unsigned - fine for dogfooding (right-click -> Open).
  if [ -n "${APPLE_SIGNING_IDENTITY:-}" ]; then
    echo "==> Deep-signing the vendored engine ($APPLE_SIGNING_IDENTITY)"
    # Notarization requires every nested Mach-O to be signed, inside-out, BEFORE the app
    # is sealed. Sign the engine tree here; Tauri copies these signed binaries into the
    # .app and then signs the outer bundle (a code signature travels inside the Mach-O,
    # so the copy preserves it). Hardened runtime (--options runtime) + the engine's
    # entitlements let the embedded Python load its bundled dylibs at runtime.
    local ents="$REPO/desktop/Entitlements.plist"
    while IFS= read -r -d '' f; do
      if file "$f" | grep -q 'Mach-O'; then
        codesign --force --timestamp --options runtime --entitlements "$ents" \
          --sign "$APPLE_SIGNING_IDENTITY" "$f" >/dev/null 2>&1 \
          || echo "  warn: could not sign $f"
      fi
    done < <(find "$REPO/desktop/engine" -type f \( -name '*.so' -o -name '*.dylib' -o -perm -u+x \) -print0)
  else
    echo "==> No APPLE_SIGNING_IDENTITY set - building UNSIGNED (right-click -> Open to run)"
  fi

  # The update bundle (Enqueue.app.tar.gz) is signed with the updater key, whose public
  # half is in tauri.conf.json (plugins.updater): an installed app takes only an update
  # that key signed. The key lives outside the repo, its password in the Keychain; made
  # once with `cargo tauri signer generate` (see AGENTS.md, "The Mac app updates itself").
  local key="${TAURI_UPDATER_KEY_FILE:-$HOME/.tauri/enqueue-updater.key}"
  [ -f "$key" ] || { echo "error: no updater key at $key" >&2; exit 1; }
  export TAURI_SIGNING_PRIVATE_KEY="$key"
  if [ -z "${TAURI_SIGNING_PRIVATE_KEY_PASSWORD:-}" ]; then
    TAURI_SIGNING_PRIVATE_KEY_PASSWORD="$(security find-generic-password -s enqueue-updater-key-password -w)" \
      || { echo "error: the updater key's password is not in the Keychain" >&2; exit 1; }
    export TAURI_SIGNING_PRIVATE_KEY_PASSWORD
  fi

  echo "==> Building the .app / .dmg"
  cd "$REPO/desktop"
  # The engine resource + macOS entitlements live in a release-only overlay so dev builds
  # (bin/launch desktop) are not forced to have desktop/engine present. Tauri validates
  # resources at build time, and signs + notarizes the bundle when the APPLE_* env is set.
  cargo tauri build --config tauri.release.conf.json

  # Notarize through a notarytool profile kept in the login keychain, so no Apple
  # password passes through this script. Make it once (it asks for an app-specific
  # password from appleid.apple.com):
  #   xcrun notarytool store-credentials enqueue-notary --apple-id <you> --team-id 572NMYL3ZG
  # then: NOTARY_PROFILE=enqueue-notary bin/release desktop
  if [ -n "${NOTARY_PROFILE:-}" ]; then
    local dmg
    dmg="$(ls -1t "$REPO"/desktop/target/release/bundle/dmg/*.dmg | head -1)"
    echo "==> Notarizing $(basename "$dmg") (a few minutes)"
    xcrun notarytool submit "$dmg" --keychain-profile "$NOTARY_PROFILE" --wait
    xcrun stapler staple "$dmg"
    spctl --assess --type open --context context:primary-signature -v "$dmg" || true
    # Notarizing the .dmg registered the app inside it too, so the .app takes its own
    # ticket; the update bundle is then made again from the stapled app and signed again.
    local bundle="$REPO/desktop/target/release/bundle/macos"
    xcrun stapler staple "$bundle/Enqueue.app"
    rm -f "$bundle/Enqueue.app.tar.gz" "$bundle/Enqueue.app.tar.gz.sig"
    COPYFILE_DISABLE=1 tar -czf "$bundle/Enqueue.app.tar.gz" -C "$bundle" Enqueue.app
    # The signer also reads the key from the environment, and refuses it twice.
    env -u TAURI_SIGNING_PRIVATE_KEY -u TAURI_SIGNING_PRIVATE_KEY_PASSWORD \
      cargo tauri signer sign -f "$TAURI_SIGNING_PRIVATE_KEY" \
      -p "$TAURI_SIGNING_PRIVATE_KEY_PASSWORD" "$bundle/Enqueue.app.tar.gz" >/dev/null
  fi
  write_update_feed

  echo
  echo "Built:"
  ls -1d "$REPO"/desktop/target/release/bundle/macos/*.app 2>/dev/null || true
  ls -1 "$REPO"/desktop/target/release/bundle/dmg/*.dmg 2>/dev/null || true
  echo
  echo "The .app carries its own engine; first launch downloads the embedding model once"
  echo "(needs network)."
  [ -n "${APPLE_SIGNING_IDENTITY:-}" ] || echo "Unsigned: on first open, right-click the app -> Open."
}

# latest.json, the feed an installed app reads (tauri.conf.json plugins.updater):
# this version, and where its signed update bundle will be on GitHub. bin/deploy desktop
# uploads it with the bundle (fastlane mac publish).
write_update_feed() {
  local bundle="$REPO/desktop/target/release/bundle/macos"
  local version
  version="$(python3 -c 'import json;print(json.load(open("'"$REPO"'/desktop/tauri.conf.json"))["version"])')"
  python3 - "$bundle" "$version" <<'EOF'
import datetime, json, pathlib, sys
bundle, version = pathlib.Path(sys.argv[1]), sys.argv[2]
signature = (bundle / "Enqueue.app.tar.gz.sig").read_text().strip()
url = f"https://github.com/sudohnim/enqueue/releases/download/mac-v{version}/Enqueue.app.tar.gz"
feed = {
    "version": version,
    "notes": f"Enqueue {version}",
    "pub_date": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
    "platforms": {"darwin-aarch64": {"signature": signature, "url": url}},
}
(bundle / "latest.json").write_text(json.dumps(feed, indent=2) + "\n")
print(f"==> Update feed for {version}: {bundle / 'latest.json'}")
EOF
}

release_android() {
  local target="${1:-aarch64}"
  cd "$REPO/desktop"

  # The Android toolchain every build uses (SDK, NDK, JDK, OpenSSL's archiver).
  source "$REPO/bin/android-env"

  # Gradle can package a stale .so if an intermediate lingers from an earlier build; clear
  # the release native-lib intermediates so the apk always carries the freshly-built lib.
  local abd="gen/android/app/build"
  rm -rf \
    "$abd/intermediates/merged_jni_libs/universalRelease" \
    "$abd/intermediates/merged_native_libs/universalRelease" \
    "$abd/intermediates/stripped_native_libs/universalRelease" \
    "$abd/outputs/apk/universal/release" 2>/dev/null || true

  # Tauri derives the versionCode from tauri.conf.json's version (0.3.0 -> 3000) and writes
  # it into gen/android/app/tauri.properties (gitignored, regenerated every build). Play
  # refuses a code it has already seen, so a store upload needs a fresh one per build:
  # ANDROID_VERSION_CODE overrides it for this build only (fastlane sets it), through a
  # config merge, so nothing in the repo changes per release.
  local overrides=()
  if [[ -n "${ANDROID_VERSION_CODE:-}" ]]; then
    [[ "$ANDROID_VERSION_CODE" =~ ^[1-9][0-9]*$ ]] \
      || { echo "ANDROID_VERSION_CODE must be a positive integer" >&2; exit 2; }
    overrides=(--config "{\"bundle\":{\"android\":{\"versionCode\":$ANDROID_VERSION_CODE}}}")
    echo "==> versionCode $ANDROID_VERSION_CODE (from ANDROID_VERSION_CODE)"
  fi

  echo "==> Building the signed release apk/aab (target: $target)"
  # No --debug: a release build embeds the frontend and signs with gen/android/key.properties.
  cargo tauri android build --target "$target" ${overrides[@]+"${overrides[@]}"}

  echo
  echo "Built:"
  ls -1 "$abd/outputs/apk/universal/release/"*.apk 2>/dev/null || true
  ls -1 "$abd/outputs/bundle/universalRelease/"*.aab 2>/dev/null || true
}

platform="${1:-}"
shift || true
case "$platform" in
  desktop) release_desktop "$@" ;;
  android) release_android "$@" ;;
  *)       usage ;;
esac
