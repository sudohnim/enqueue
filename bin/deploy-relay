#!/usr/bin/env bash
# Deploy the Enqueue sync relay to Railway.
#
# Usage: bin/deploy-relay [-y]
#
# There is one relay: the `enqueue` service in the `enqueue` Railway project
# (environment `production`), with its Postgres beside it for accounts. It is the
# live relay every linked device syncs through, so a deploy asks first; -y skips
# the question (for a script that has already asked).
#
# The relay is a dumb ciphertext byte store (src/enqueue/relay). This ships the
# repo's Dockerfile to the service and waits for /health to go green.
#
# Why the staging copy: `railway up` uploads its working directory, and this
# repo carries a multi-hundred-MB desktop/target and Android build output that
# the relay image does not need. We rsync only the Docker build context
# (Dockerfile + pyproject.toml + uv.lock + src/) into a tmp dir and deploy from
# there, so the upload is small and reproducible.
#
# RELAY_SERVICE names another service to deploy to (a staging relay, once there
# is one, with its own volume, secrets, Postgres and sign-in clients).
set -euo pipefail

yes=0
case "${1:-}" in
  "") ;;
  -y) yes=1 ;;
  *) echo "usage: bin/deploy-relay [-y]" >&2; exit 2 ;;
esac
SERVICE="${RELAY_SERVICE:-enqueue}"
PROJECT="${RAILWAY_PROJECT:-enqueue}"
RAILWAY_ENVIRONMENT="${RAILWAY_ENVIRONMENT:-production}"
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
STAGE="$(mktemp -d /tmp/enqueue-relay-deploy.XXXXXX)"
trap 'rm -rf "$STAGE"' EXIT

# --- preflight ---------------------------------------------------------------
command -v railway >/dev/null || { echo "railway CLI not installed (brew install railway)" >&2; exit 1; }
railway whoami >/dev/null 2>&1 || { echo "not logged in: run 'railway login'" >&2; exit 1; }
command -v rsync >/dev/null || { echo "rsync not found" >&2; exit 1; }

# The relay tests must pass before shipping: a broken put() silently drops every
# sync, and a broken sign-in check lets anyone in. Cheap to gate here rather than
# discover it against the live relay.
echo "running relay tests before deploy ..."
(cd "$ROOT" && uv run pytest tests/test_relay.py tests/test_relay_accounts.py -q) \
  || { echo "relay tests failed - not deploying" >&2; exit 1; }

if [[ "$yes" != 1 ]]; then
  read -r -p "Deploy to the live relay ($SERVICE)? [y/N] " ans
  [[ "$ans" == "y" || "$ans" == "Y" ]] || { echo "aborted"; exit 1; }
fi

# --- stage the Docker build context -----------------------------------------
# Only what the Dockerfile COPYs, plus the Dockerfile itself.
rsync -a \
  "$ROOT/Dockerfile" \
  "$ROOT/pyproject.toml" \
  "$ROOT/uv.lock" \
  "$STAGE/"
rsync -a --exclude='__pycache__' --exclude='*.egg-info' "$ROOT/src/" "$STAGE/src/"

cd "$STAGE"
railway link --project "$PROJECT" --environment "$RAILWAY_ENVIRONMENT" --service "$SERVICE" >/dev/null 2>&1 \
  || { echo "could not link service '$SERVICE' in project '$PROJECT' ($RAILWAY_ENVIRONMENT)." >&2
       echo "For a new service: create it once in the Railway dashboard (add a volume" >&2
       echo "at /data and set RELAY_SECRET, RELAY_DATA_DIR=/data and RELAY_ADMIN_SECRET;" >&2
       echo "for accounts also a Postgres, DATABASE_URL, JWT_SECRET and the sign-in" >&2
       echo "client ids, see AGENTS.md \"The relay\"), then re-run." >&2
       exit 1; }
railway up --service "$SERVICE" --detach

# --- verify ------------------------------------------------------------------
URL="$(railway domain list --service "$SERVICE" 2>/dev/null | awk '/up\.railway\.app/ {print "https://"$1; exit}')"
if [[ -z "$URL" ]]; then
  echo "deploy started, but no public domain yet."
  echo "run once: railway domain --service $SERVICE   then re-check /health"
  exit 0
fi

echo "waiting for $URL/health ..."
for _ in $(seq 1 30); do
  sleep 10
  body="$(curl -sS -m 10 "$URL/health" 2>/dev/null || true)"
  if [[ "$body" == *'"status":"ok"'* ]]; then
    echo "healthy: $body"
    echo "relay is live at $URL"
    exit 0
  fi
done
echo "did not become healthy in 5min - check: railway logs --service $SERVICE" >&2
exit 1
