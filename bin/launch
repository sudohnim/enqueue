#!/usr/bin/env bash
# Launch Enqueue on a chosen platform.
#
#   bin/launch desktop          rebuild the shell, restart engine + macOS window, front
#   bin/launch mobile           build + install + run on a PLUGGED-IN Android phone
#   bin/launch emulator         build + install + run on a headless Android emulator (AVD)
#   bin/launch ios              build + install + run on a PLUGGED-IN iPhone
#   bin/launch simulator        build + install + run in the iOS Simulator
#
# Desktop always rebuilds first (cargo is incremental, so it is near-instant when
# nothing changed) - the window you see is always the current code.
#
# Desktop and the engine share one lifetime: the shell kills its own engine when the
# window closes, so they come up together or not at all. Mobile is a separate target -
# it needs a real phone on USB (debugging on); an emulator is deliberately NOT accepted
# here, because "bin/launch mobile" means "put it on my phone."
#
# Both mobile and emulator do a ONE-SHOT build + adb install + launch, then EXIT. They
# never run `cargo tauri android dev`: that starts a watch loop that never returns and
# holds the Gradle lock, which deadlocks the next `cargo tauri android build`. Re-run
# the command to push a new build; nothing is left running in between.
#
# The emulator path is for headless device verification (CDP, uiautomator, screencap,
# run-as) without a physical phone. The emulator reaches the LOCAL relay at
# 10.0.2.2:8788 (the host's loopback); a hosted relay (Railway) is normal internet.
# The debug apk now loads the embedded frontend (devUrl removed in RELEASE.1), so the
# debug build works on the emulator without a dev server.
# The frontend (src/enqueue/static, tauri.conf.json frontendDist) is embedded into the
# Rust .so at compile time and served from there; web-only edits reach the device on
# the next build with no copy step. gen/android/app/src/main/assets is NOT the webview
# source (verified 2026-09-26: a stale mobile.html planted there was packaged but never
# served), so do not sync static files into it.

set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

usage() {
  echo "usage: bin/launch <desktop|mobile|emulator|ios|simulator>" >&2
  exit 2
}

# Prune stale Android target dirs. The mobile/emulator paths only ever build
# `--target aarch64`, but old builds for other arches (x86_64/i686/armv7) linger in
# desktop/target and each holds its own ~400MB libenqueue_lib.a + deps - dead weight
# that is never rebuilt by this script. Removing them reclaims ~7GB while leaving the
# aarch64 dir intact, so incremental rebuilds of the arch we actually use stay fast.
prune_stale_android_targets() {
  local arch dir
  for arch in x86_64-linux-android i686-linux-android armv7-linux-androideabi; do
    dir="$REPO/desktop/target/$arch"
    if [[ -d "$dir" ]]; then
      echo "Pruning stale android target: $arch"
      rm -rf "$dir"
    fi
  done
}

# JS parse gate. The interface is inline/served <script>. A single stray quote takes
# out every function at once, and the page still serves 200 with no console error the
# harness can see, so it looks like a behaviour bug rather than a parse failure. Cheap
# to check, expensive to miss. `$1` is a space-separated list of pages to check:
# home/capture concat their static/js, mobile concats md.js + its inline script.
js_gate() {
  command -v node >/dev/null 2>&1 || return 0
  local page JS
  for page in $1; do
    JS="$(mktemp -t enqueue-js).js"
    if [[ "$page" == "home" ]]; then
      cat "$REPO"/src/enqueue/static/js/{util,icons,md,diff,tabs,linkpop,suggest,details,guides,tour,dialogs,pill,morph,home,artifact,search,pivot,chat,trash,drafts,notetabs,settings_guide,settings}.js > "$JS"
    elif [[ "$page" == "mobile" ]]; then
      cat "$REPO"/src/enqueue/static/js/{md,linkpop,suggest,details,guides,tour}.js > "$JS"
      python3 - "$REPO/src/enqueue/static/mobile.html" "$JS" <<'PY'
import re, sys
src = open(sys.argv[1], encoding="utf-8").read()
blocks = re.findall(r"<script[^>]*>(.*?)</script>", src, re.S)
if blocks:
    with open(sys.argv[2], "a", encoding="utf-8") as f:
        f.write("\n" + "\n".join("{\n" + b + "\n}" for b in blocks))
PY
    else
      python3 - "$REPO/src/enqueue/static/$page.html" "$JS" <<'PY'
import re, sys
src = open(sys.argv[1], encoding="utf-8").read()
blocks = re.findall(r"<script[^>]*>(.*?)</script>", src, re.S)
if not blocks:
    sys.exit("no script found in " + sys.argv[1])
open(sys.argv[2], "w", encoding="utf-8").write(
    "\n".join("{\n" + b + "\n}" for b in blocks)
)
PY
    fi
    if ! node --check "$JS"; then
      echo "$page does not parse. not launching." >&2
      rm -f "$JS"
      exit 1
    fi
    rm -f "$JS"
  done
}

launch_desktop() {
  local BIN="$REPO/desktop/target/debug/Enqueue"
  local LOG="${TMPDIR:-/tmp}/enqueue-app.log"

  # Always build the latest. cargo is incremental, so this is a fast no-op when nothing
  # changed, and a compile error stops here rather than silently launching a stale
  # binary. That is the whole point: the window you see is always the code on disk.
  echo "building the shell..."
  (cd "$REPO/desktop" && cargo build)

  # The shell kills its own engine when the window closes, so stop the window first
  # and let it clean up rather than orphaning a process on the port.
  pkill -f "Enqueue" 2>/dev/null || true
  sleep 1
  pkill -f "enq serve" 2>/dev/null || true
  # A frozen engine never acts on the polite signal (its main thread cannot take the
  # GIL to run the handler: the 2026-10-20 SQLite deadlock), and then the new one
  # cannot bind the port and launch waits for a health that never comes. Give it five
  # seconds, then stop it hard; SQLite's write-ahead log survives that.
  for _ in 1 2 3 4 5; do
    pgrep -f "enq serve" >/dev/null || break
    sleep 1
  done
  pkill -9 -f "enq serve" 2>/dev/null || true
  pkill -9 -f "target/debug/Enqueue" 2>/dev/null || true
  sleep 1

  js_gate "home capture"

  # Where the shell finds the engine: a pointer in the library's folder (Application
  # Support; the engine moves an old ~/.enqueue-poc there on its first start, datadir.py).
  DATA_DIR="${ENQ_DATA_DIR:-$HOME/Library/Application Support/Enqueue}"
  mkdir -p "$DATA_DIR" && echo "$REPO" > "$DATA_DIR/repo" 2>/dev/null || true

  # No user agent is set here: previews introduce themselves honestly (AGENTS.md, "Link
  # previews"), the shipped app never runs this script, and a value set here would lock
  # Settings' field. A site that refuses is what "Try harder" (a real browser) is for.

  ENQUEUE_REPO="$REPO" "$BIN" >"$LOG" 2>&1 &

  # The window is only useful once the engine behind it answers.
  for _ in $(seq 1 40); do
    if curl -sf -o /dev/null http://127.0.0.1:8787/health; then break; fi
    sleep 0.5
  done

  if ! curl -sf -o /dev/null http://127.0.0.1:8787/health; then
    echo "engine never came up. log:" >&2
    tail -20 "$LOG" >&2
    exit 1
  fi

  # Launched from a shell, the process is not frontmost, so the window opens behind
  # whatever the person was looking at and reads as a launch that failed.
  osascript -e 'tell application "System Events" to tell process "Enqueue" to set frontmost to true' 2>/dev/null || true

  echo "up: $(curl -s http://127.0.0.1:8787/health)"
  echo "log: $LOG"
}

launch_mobile() {
  # Android toolchain env. Respect anything already exported; fall back to the standard
  # Android Studio locations. NDK_HOME picks the newest installed NDK unless set.
  source "$(dirname "${BASH_SOURCE[0]}")/android-env"
  export PATH="$ANDROID_HOME/platform-tools:$PATH"

  local ADB="$ANDROID_HOME/platform-tools/adb"
  if [[ ! -x "$ADB" ]]; then
    echo "adb not found at $ADB. Is the Android SDK installed?" >&2
    exit 1
  fi

  # Require a PHYSICAL phone on USB. Emulators (serial emulator-NNNN) are rejected here
  # on purpose: "bin/launch mobile" means put it on the real device.
  local serial="" line dev state
  while IFS=$'\t ' read -r dev state _; do
    [[ "$state" == "device" ]] || continue
    [[ "$dev" == emulator-* ]] && continue
    serial="$dev"
    break
  done < <("$ADB" devices)

  if [[ -z "$serial" ]]; then
    echo "no Android phone connected." >&2
    echo "Plug in your phone over USB, enable USB debugging, accept the prompt, then retry." >&2
    echo >&2
    echo "adb sees:" >&2
    "$ADB" devices >&2
    exit 1
  fi

  echo "phone: $serial"
  echo "NDK:   ${NDK_HOME:-<none found>}"
  export ANDROID_SERIAL="$serial"   # pins gradle + adb to the phone, ignores any emulator

  js_gate "mobile"

  # One-shot build + install + launch, then EXIT. Do NOT use `cargo tauri android dev`:
  # it starts a dev-server/watch loop that never returns and holds the Gradle lock, so
  # the next `cargo tauri android build` deadlocks waiting for it (the recurring lock
  # bug). A plain build + adb install puts the app on the phone and leaves nothing
  # running - re-open the app on the device to see later changes after another launch.
  cd "$REPO/desktop"
  echo "Building debug apk..."
  cargo tauri android build --debug --target aarch64

  local APK
  APK="$(ls -t "$REPO"/desktop/gen/android/app/build/outputs/apk/*/debug/*.apk 2>/dev/null | head -1)"
  [[ -n "$APK" ]] || { echo "no debug apk produced" >&2; exit 1; }

  echo "Installing $(basename "$APK") on $serial ..."
  "$ADB" -s "$serial" install -r "$APK" || {
    echo "install -r failed (signature mismatch?); reinstalling clean"
    "$ADB" -s "$serial" uninstall com.sudohnim.enqueue >/dev/null 2>&1
    "$ADB" -s "$serial" install "$APK"
  }
  "$ADB" -s "$serial" shell am start -n com.sudohnim.enqueue/.MainActivity >/dev/null 2>&1 || true

  echo ""
  echo "Installed + launched on $serial. This command has EXITED (nothing hangs)."
  echo "Device logs, if you want them:  $ADB -s $serial logcat"

  prune_stale_android_targets
}

launch_emulator() {
  # Android toolchain env - same as launch_mobile
  source "$(dirname "${BASH_SOURCE[0]}")/android-env"
  export PATH="$ANDROID_HOME/platform-tools:$ANDROID_HOME/emulator:$PATH"

  local ADB="$ANDROID_HOME/platform-tools/adb"
  local EMU="$ANDROID_HOME/emulator/emulator"
  if [[ ! -x "$ADB" ]]; then
    echo "adb not found at $ADB. Is the Android SDK installed?" >&2
    exit 1
  fi
  if [[ ! -x "$EMU" ]]; then
    echo "emulator not found at $EMU. Install 'Android Emulator' in SDK Manager." >&2
    exit 1
  fi

  # AVD name - default to 'enqueue-avd', allow override via env
  local AVD_NAME="${ENQUEUE_AVD:-enqueue}"

  # Check if AVD exists, create if not (requires human to run once interactively)
  if ! "$EMU" -list-avds | grep -q "^${AVD_NAME}$"; then
    echo "AVD '$AVD_NAME' not found." >&2
    echo "Create it once interactively:" >&2
    echo "  \$ sdkmanager 'system-images;android-36;google_apis;arm64-v8a'" >&2
    echo "  \$ avdmanager create avd -n ${AVD_NAME} -k 'system-images;android-36;google_apis;arm64-v8a' -d pixel_7" >&2
    echo "Or set ENQUEUE_AVD to an existing AVD name." >&2
    exit 1
  fi

  js_gate "mobile"

  echo "Starting emulator '$AVD_NAME' headless..."
  # Boot headless, no audio, no snapshot, wait for boot
  "$EMU" -avd "$AVD_NAME" -no-window -no-audio -no-snapshot-load -no-snapshot-save -gpu swiftshader_indirect &
  local EMU_PID=$!

  # Wait for device to appear and boot to complete
  echo "Waiting for emulator to boot..."
  local serial=""
  for _ in $(seq 1 60); do
    serial="$("$ADB" devices 2>/dev/null | awk '/emulator-/{print $1; exit}')"
    [[ -n "$serial" ]] && break
    sleep 2
  done
  [[ -n "$serial" ]] || { echo "emulator never appeared" >&2; kill $EMU_PID 2>/dev/null; exit 1; }

  # Wait for boot_completed
  for _ in $(seq 1 120); do
    if "$ADB" -s "$serial" shell getprop sys.boot_completed 2>/dev/null | grep -q "1"; then
      break
    fi
    sleep 1
  done
  "$ADB" -s "$serial" shell getprop sys.boot_completed 2>/dev/null | grep -q "1" || { echo "emulator boot timeout" >&2; kill $EMU_PID 2>/dev/null; exit 1; }

  echo "Emulator booted: $serial"
  export ANDROID_SERIAL="$serial"

  # Build the debug apk ONE-SHOT, then install + launch via adb and EXIT. Do NOT use
  # `cargo tauri android dev` here: it starts a dev-server/watch loop that never returns
  # (and hangs on "pick a device"), which is useless for headless agent verification.
  # A one-shot build + adb install lets an agent drive the app (screencap, CDP,
  # uiautomator, run-as) over adb with no hung foreground process.
  cd "$REPO/desktop"
  echo "Building debug apk (recompiles from scratch if target was cleaned)..."
  cargo tauri android build --debug --target aarch64

  local APK
  APK="$(ls -t "$REPO"/desktop/gen/android/app/build/outputs/apk/*/debug/*.apk 2>/dev/null | head -1)"
  [[ -n "$APK" ]] || { echo "no debug apk produced" >&2; exit 1; }

  echo "Installing $(basename "$APK") on $serial ..."
  "$ADB" -s "$serial" install -r "$APK" || {
    echo "install -r failed (signature mismatch?); reinstalling clean"
    "$ADB" -s "$serial" uninstall com.sudohnim.enqueue >/dev/null 2>&1
    "$ADB" -s "$serial" install "$APK"
  }
  "$ADB" -s "$serial" shell am start -n com.sudohnim.enqueue/.MainActivity >/dev/null 2>&1 || true

  echo ""
  echo "Ready. Emulator serial: $serial (app installed + launched). This command has EXITED."
  echo "Drive it over adb (nothing hangs):"
  echo "  $ADB -s $serial exec-out screencap -p > /tmp/shot.png"
  echo "  $ADB -s $serial shell input tap <x> <y>"
  echo "  $ADB -s $serial forward tcp:9222 localabstract:webview_devtools_remote_\$($ADB -s $serial shell pidof com.sudohnim.enqueue)"
  echo "The emulator keeps running in the background (pid $EMU_PID). Stop it with: kill $EMU_PID"

  prune_stale_android_targets
}

# --- iOS ---------------------------------------------------------------------------
# Same shape as the Android paths: a ONE-SHOT build, install, launch, then EXIT (never
# `cargo tauri ios dev`, which is a watch loop). The Xcode project is desktop/gen/apple;
# the signing team is bundle.iOS.developmentTeam in tauri.conf.json. Toolchain: bin/setup --ios.
IOS_BUNDLE_ID="com.sudohnim.enqueue"

ios_built_app() {
  # `cargo tauri ios build` moves the app out of the archive into build/<arch>/, and
  # fails ("Directory not empty") when the last build's copy is still there.
  local dir="$REPO/desktop/gen/apple/build/$1"
  rm -rf "$dir/Enqueue.app"
  (cd "$REPO/desktop" && cargo tauri ios build --debug "${@:2}") >&2
  [[ -d "$dir/Enqueue.app" ]] || { echo "no app produced at $dir/Enqueue.app" >&2; exit 1; }
  echo "$dir/Enqueue.app"
}

ios_booted_simulator() {
  xcrun simctl list devices booted | sed -n 's/.*(\([0-9A-F-]\{36\}\)) (Booted).*/\1/p' | head -1
}

launch_simulator() {
  command -v xcrun >/dev/null 2>&1 || { echo "Xcode is not installed (run bin/setup --ios)" >&2; exit 1; }
  js_gate "mobile"
  # The booted simulator, else the one named by ENQUEUE_SIM (default: iPhone 17 Pro).
  local udid
  udid="$(ios_booted_simulator)"
  if [[ -z "$udid" ]]; then
    local name="${ENQUEUE_SIM:-iPhone 17 Pro}"
    echo "Booting simulator '$name'..."
    xcrun simctl boot "$name" || { echo "could not boot '$name' (xcrun simctl list devices)" >&2; exit 1; }
    udid="$(ios_booted_simulator)"
  fi
  open -a Simulator >/dev/null 2>&1 || true

  local app
  app="$(ios_built_app arm64-sim --target aarch64-sim)"
  xcrun simctl install "$udid" "$app"
  xcrun simctl launch "$udid" "$IOS_BUNDLE_ID" >/dev/null
  echo ""
  echo "Ready. Simulator $udid (app installed + launched). This command has EXITED."
  echo "  xcrun simctl io $udid screenshot /tmp/shot.png"
  echo "The simulator has no camera: linking by QR needs a real iPhone (bin/launch ios)."
}

launch_ios() {
  command -v xcrun >/dev/null 2>&1 || { echo "Xcode is not installed (run bin/setup --ios)" >&2; exit 1; }
  # A real iPhone, connected and trusted. A simulator is deliberately not accepted
  # here, for the same reason `bin/launch mobile` refuses an emulator.
  local devices="${TMPDIR:-/tmp}/enqueue-ios-devices.json"
  xcrun devicectl list devices --json-output "$devices" >/dev/null 2>&1 || true
  local device
  device="$(python3 - "$devices" <<'PY'
import json, sys
try:
    found = json.load(open(sys.argv[1]))["result"]["devices"]
except Exception:
    found = []
for d in found:
    hw, conn = d.get("hardwareProperties", {}), d.get("connectionProperties", {})
    if hw.get("platform") == "iOS" and hw.get("reality") == "physical" \
            and conn.get("tunnelState") != "unavailable":
        print(d["identifier"])
        break
PY
)"
  if [[ -z "$device" ]]; then
    echo "no iPhone connected." >&2
    echo "Plug it in, unlock it, tap Trust, and turn on Developer Mode" >&2
    echo "(Settings > Privacy & Security > Developer Mode), then retry." >&2
    echo "" >&2
    xcrun devicectl list devices >&2 || true
    exit 1
  fi
  js_gate "mobile"

  local app
  app="$(ios_built_app arm64 --export-method debugging)"
  echo "Installing on $device ..."
  xcrun devicectl device install app --device "$device" "$app"
  xcrun devicectl device process launch --device "$device" "$IOS_BUNDLE_ID" >/dev/null || \
    echo "installed; open Enqueue on the phone (it must be unlocked to launch from here)."
  echo ""
  echo "Ready. Installed on $device. This command has EXITED."
}

[[ $# -ge 1 ]] || usage
platform="$1"
shift
case "$platform" in
  desktop) launch_desktop "$@" ;;
  mobile)  launch_mobile "$@" ;;
  emulator) launch_emulator "$@" ;;
  ios)      launch_ios "$@" ;;
  simulator) launch_simulator "$@" ;;
  *)       usage ;;
esac