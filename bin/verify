#!/usr/bin/env python3
"""Gate: JS parse check on both pages, pytest, contrast check, Android compile check.

home.html has no inline scripts since M.8: its JS lives in static/js/*.js,
loaded by <script src> in shell order. Each file is checked individually
(clear per-file errors) and all of them concatenated (catches a top-level
const/let/function redeclared across two files, which the individual checks
cannot see - separate classic scripts share the global scope).

capture.html still carries its JS inline: every <script> block is wrapped in
{ } so const/let scoping cannot collide across blocks, then run through
node --check.

The Android compile check runs the full `cargo tauri android build --debug` when a
changed file (staged, unstaged, or untracked) could break the apk in a way `cargo
check` never parses - Kotlin/gradle/manifest/resource files under desktop/gen/android,
or the build config (desktop/tauri.conf.json, build.rs, Cargo.toml). Otherwise it runs
the faster `cargo check --lib --target aarch64-linux-android`. It is skipped with a
clear message when the Android toolchain/NDK is absent (so non-mobile machines are not
blocked). A green bin/verify is NOT proof the app runs - the desktop window and
a real device are the only proof (per AGENTS.md "reproduce in a real setting"
rule).
"""
import os
import re
import subprocess
import sys
import tempfile

SRC = "bin/verify"
HERE = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
FILES = [
    "src/enqueue/static/home.html",
    "src/enqueue/static/capture.html",
    "src/enqueue/static/mobile.html",
]
JS_DIR = os.path.join(HERE, "src", "enqueue", "static", "js")
JS_ORDER = [
    "util.js",
    "icons.js",
    "md.js",
    "dialogs.js",
    "pill.js",
    "morph.js",
    "home.js",
    "artifact.js",
    "search.js",
    "pivot.js",
    "chat.js",
    "trash.js",
    "settings.js",
]
# The mobile shell (MOB.2) loads md.js for markdown; MOB.4+ adds the mobile UI's
# scripts here, checked the same way the home page's are.
MOBILE_JS_ORDER = ["md.js"]

def extract_script_blocks(path):
    with open(path, encoding="utf-8") as f:
        html = f.read()
    blocks = re.findall(r"<script[^>]*>(.*?)</script>", html, re.DOTALL)
    return [b.strip() for b in blocks if b.strip()]

def node_check(source, label):
    with tempfile.NamedTemporaryFile(mode="w", suffix=".js", delete=False) as f:
        f.write(source)
        tmp = f.name
    try:
        result = subprocess.run(
            ["node", "--check", tmp],
            capture_output=True, text=True, timeout=30,
        )
        if result.returncode == 0:
            print(f"{SRC}: JS parse OK: {label}")
            return True
        else:
            print(f"{SRC}: JS parse FAILED: {label}", file=sys.stderr)
            print(result.stderr, file=sys.stderr)
            return False
    except subprocess.TimeoutExpired:
        print(f"{SRC}: JS parse TIMEOUT: {label}", file=sys.stderr)
        return False
    finally:
        os.unlink(tmp)

def check_js_files(order, concat_label):
    """Parse each file in `order` individually, then all of them concatenated."""
    missing = [f for f in order if not os.path.isfile(os.path.join(JS_DIR, f))]
    if missing:
        print(f"{SRC}: missing js files: {', '.join(missing)}", file=sys.stderr)
        return False
    ok = True
    for name in order:
        with open(os.path.join(JS_DIR, name), encoding="utf-8") as f:
            source = f.read()
        if not node_check(source, f"static/js/{name}"):
            ok = False
    if order:
        combined = ""
        for name in order:
            with open(os.path.join(JS_DIR, name), encoding="utf-8") as f:
                combined += f.read() + "\n"
        if not node_check(combined, concat_label):
            ok = False
    return ok

def check_home_js():
    return check_js_files(
        JS_ORDER, "static/js/*.js concatenated (cross-file scoping)"
    )

def check_mobile_js():
    return check_js_files(
        MOBILE_JS_ORDER, "static/js mobile concatenated (cross-file scoping)"
    )

def check_inline_js(path):
    blocks = extract_script_blocks(path)
    if not blocks:
        print(f"{SRC}: WARNING: no <script> blocks found in {path}")
        return True
    # Wrap each block in { } so const/let are scoped and don't collide
    wrapped = "\n".join("{" + b + "\n}" for b in blocks)
    return node_check(wrapped, path)

def check_android_compile():
    """Check that the mobile module compiles for Android (Rust + Kotlin)."""
    desktop_dir = os.path.join(HERE, "desktop")
    
    # Auto-detect Android SDK and NDK from standard locations (same as bin/launch mobile)
    android_home = os.environ.get("ANDROID_HOME")
    if not android_home or not os.path.isdir(android_home):
        android_home = os.path.expanduser("~/Library/Android/sdk")
    
    ndk_home = os.environ.get("NDK_HOME")
    if not ndk_home or not os.path.isdir(ndk_home):
        ndk_parent = os.path.join(android_home, "ndk")
        ndk_dirs = sorted(
            d for d in os.listdir(ndk_parent)
            if os.path.isdir(os.path.join(ndk_parent, d))
        ) if os.path.isdir(ndk_parent) else []
        if ndk_dirs:
            ndk_home = os.path.join(ndk_parent, ndk_dirs[-1])
    
    if not android_home or not os.path.isdir(android_home):
        print(f"{SRC}: Android compile check SKIPPED - Android SDK not found at {android_home}")
        return True
    
    if not ndk_home or not os.path.isdir(ndk_home):
        print(f"{SRC}: Android compile check SKIPPED - NDK not found at {ndk_home}")
        return True
    
    # Check if the target is installed
    rustup_target = subprocess.run(
        ["rustup", "target", "list", "--installed"],
        capture_output=True, text=True, timeout=30
    )
    if "aarch64-linux-android" not in rustup_target.stdout:
        print(f"{SRC}: Android compile check SKIPPED - aarch64-linux-android target not installed")
        return True
    
    # Check if the NDK has the required clang tool (unversioned name)
    # Determine the host platform for the NDK toolchain path
    import platform
    host_platform = "darwin-x86_64" if platform.system() == "Darwin" else "linux-x86_64"
    toolchain_bin = os.path.join(ndk_home, "toolchains", "llvm", "prebuilt", host_platform, "bin")
    clang_path = os.path.join(toolchain_bin, "aarch64-linux-android-clang")
    
    if not os.path.exists(clang_path):
        # Try to find versioned clang and create symlink, or skip
        versioned_clang = None
        if os.path.isdir(toolchain_bin):
            for f in os.listdir(toolchain_bin):
                if f.startswith("aarch64-linux-android") and f.endswith("-clang") and not f.endswith("++"):
                    versioned_clang = os.path.join(toolchain_bin, f)
                    break
        if versioned_clang:
            # Create symlink for the build
            try:
                os.symlink(versioned_clang, clang_path)
            except (OSError, FileExistsError):
                pass
        else:
            print(f"{SRC}: Android compile check SKIPPED - aarch64-linux-android-clang not found in NDK")
            return True
    
    # Decide whether to run the full `cargo tauri android build` (catches Kotlin/gradle/
    # config breakage that `cargo check --lib` never parses) or the fast Rust-only check.
    # Look at BOTH staged and unstaged/untracked changes vs HEAD: this is run standalone,
    # not only as a staged pre-commit step, so an unstaged broken gradle/conf must still
    # trip the full build (`git status --porcelain` covers staged + unstaged + untracked).
    changed = subprocess.run(
        ["git", "status", "--porcelain", "--untracked-files=all"],
        cwd=HERE,
        capture_output=True,
        text=True,
        timeout=10
    ).stdout.splitlines()
    changed_files = []
    for line in changed:
        if not line.strip():
            continue
        path = line[3:].strip()
        if " -> " in path:  # renames render as "old -> new"
            path = path.split(" -> ", 1)[1].strip()
        changed_files.append(path)

    def _needs_full_android_build(f):
        # Kotlin, gradle scripts, manifests, and android resources are invisible to
        # `cargo check` and only fail in the full build. Note `.kts` (not just `.kt`).
        if f.startswith("desktop/gen/android/") and f.endswith(
            (".kt", ".kts", ".gradle", ".xml", ".properties", ".pro")
        ):
            return True
        # Build config that shapes the apk itself (devUrl, bundle targets, signing,
        # the registered command list) - a bad value here breaks the build, not the check.
        if f in ("desktop/tauri.conf.json", "desktop/build.rs", "desktop/Cargo.toml"):
            return True
        return False

    android_files_staged = any(_needs_full_android_build(f) for f in changed_files)

    print(f"=== {SRC}: Android compile check ===")
    env = os.environ.copy()
    env["ANDROID_HOME"] = android_home
    env["NDK_HOME"] = ndk_home
    # Ensure cargo can find the NDK toolchain
    env["PATH"] = f"{toolchain_bin}:{android_home}/platform-tools:{env.get('PATH', '')}"
    
    if android_files_staged:
        print(f"{SRC}: Android/build files changed, running full cargo tauri android build")
        result = subprocess.run(
            ["cargo", "tauri", "android", "build", "--debug"],
            cwd=desktop_dir,
            env=env,
            capture_output=False,
            timeout=600
        )
    else:
        # No Android files staged, just check Rust compilation (faster)
        result = subprocess.run(
            ["cargo", "check", "--lib", "--target", "aarch64-linux-android"],
            cwd=desktop_dir,
            env=env,
            capture_output=False,
            timeout=300
        )
    
    if result.returncode == 0:
        print(f"{SRC}: Android compile OK")
        return True
    else:
        print(f"{SRC}: Android compile FAILED", file=sys.stderr)
        return False

def main():
    os.chdir(HERE)
    pass_flag = True

    print(f"=== {SRC}: JS parse: {FILES[0]} (static/js/*.js) ===")
    if not check_home_js():
        pass_flag = False

    print("")
    print(f"=== {SRC}: JS parse: {FILES[1]} ===")
    if not check_inline_js(FILES[1]):
        pass_flag = False

    print("")
    print(f"=== {SRC}: JS parse: {FILES[2]} (mobile shell) ===")
    if not check_mobile_js():
        pass_flag = False
    if not check_inline_js(FILES[2]):
        pass_flag = False

    print("")
    print(f"=== {SRC}: pytest ===")
    r = subprocess.run(["uv", "run", "pytest", "-q"], capture_output=False, timeout=300)
    if r.returncode == 0:
        print(f"{SRC}: pytest OK")
    else:
        print(f"{SRC}: pytest FAILED", file=sys.stderr)
        pass_flag = False

    print("")
    print(f"=== {SRC}: contrast check ===")
    r = subprocess.run(["bin/check-contrast"], capture_output=False, timeout=30)
    if r.returncode == 0:
        print(f"{SRC}: contrast OK")
    else:
        print(f"{SRC}: contrast check FAILED", file=sys.stderr)
        pass_flag = False

    print("")
    if not check_android_compile():
        pass_flag = False

    print("")
    if pass_flag:
        print(f"{SRC}: all checks passed")
        sys.exit(0)
    else:
        print(f"{SRC}: some checks FAILED", file=sys.stderr)
        sys.exit(1)

if __name__ == "__main__":
    main()