{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Enqueue",
  "version": "0.1.0",
  "identifier": "com.sudohnim.enqueue",
  "build": {
    "frontendDist": "../src/enqueue/static"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "capture-overlay",
          "description": "Lets the quick-capture overlay put itself away and be dragged by its title bar.",
          "windows": ["capture"],
          "remote": {
            "urls": ["http://127.0.0.1:8787/*", "http://localhost:8787/*"]
          },
          "permissions": [
            "allow-capture-dismiss",
            "allow-capture-done",
            "allow-capture-drag",
            "core:event:allow-listen",
            "core:event:allow-unlisten"
          ]
        },
        {
          "identifier": "home-links",
          "description": "Lets the home window hand a saved http(s) address to the system browser, and drag its own window by the top strip. Both are refused by default because the page is served from a remote origin.",
          "windows": ["main"],
          "remote": {
            "urls": ["http://127.0.0.1:8787/*", "http://localhost:8787/*"]
          },
          "permissions": [
            "allow-hotkey-changed",
            "allow-open-external",
            "allow-window-drag",
            "core:event:allow-listen",
            "core:event:allow-unlisten"
          ]
        }
      ]
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "category": "Productivity",
    "copyright": "",
    "shortDescription": "Capture anything, organise it later."
  }
}
