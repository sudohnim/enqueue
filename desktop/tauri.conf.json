{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Enqueue",
  "version": "0.1.0",
  "identifier": "com.sudohnim.enqueue",
  "build": {
    "frontendDist": "../src/enqueue/static"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "capture-overlay",
          "description": "Lets the quick-capture overlay put itself away and be dragged by its title bar.",
          "windows": [
            "capture"
          ],
          "remote": {
            "urls": [
              "http://127.0.0.1:8787/*",
              "http://localhost:8787/*"
            ]
          },
          "permissions": [
            "allow-capture-dismiss",
            "allow-capture-drag",
            "core:event:allow-listen",
            "core:event:allow-unlisten"
          ]
        },
        {
          "identifier": "home-links",
          "description": "Lets the home window hand a saved http(s) address to the system browser, drag its own window by the top strip, and show the Signal-style linking QR for mobile setup (QR.3). All are refused by default because the page is served from a remote origin.",
          "windows": [
            "main"
          ],
          "remote": {
            "urls": [
              "http://127.0.0.1:8787/*",
              "http://localhost:8787/*"
            ]
          },
          "permissions": [
            "allow-hotkey-changed",
            "allow-open-external",
            "allow-window-drag",
            "allow-desktop-link-code",
            "core:event:allow-listen",
            "core:event:allow-unlisten"
          ]
        },
        {
          "identifier": "mobile-library",
          "description": "Lets the mobile shell pull the synced library into the local SQLite read copy (MOB.3) and read it (MOB.4/MOB.5). The mobile window loads an app URL, not the remote engine, so this capability has no remote restriction.",
          "windows": [
            "main"
          ],
          "permissions": [
            "allow-mobile-sync",
            "allow-mobile-link-qr",
            "allow-mobile-delete",
            "allow-mobile-restore",
            "allow-mobile-empty-trash",
            "allow-mobile-list",
            "allow-mobile-pivots",
            "allow-mobile-get",
            "allow-mobile-status",
            "allow-mobile-search",
            "allow-mobile-capture",
            "allow-mobile-blob",
            "allow-mobile-capture-image",
            "allow-mobile-outbox-push",
            "allow-mobile-outbox-list",
            "allow-mobile-pick-image",
            "allow-mobile-save-cropped-image",
            "allow-mobile-chat",
            "allow-mobile-settings-get",
            "allow-mobile-settings-set",
            "allow-mobile-settings-sync",
            "allow-mobile-settings-apply",
            "allow-mobile-pairing-code",
            "allow-mobile-pairing-setup",
            "allow-mobile-clear-blob-cache",
            "allow-mobile-update-note",
            "allow-mobile-add-annotation",
            "allow-mobile-remove-annotation",
            "allow-mobile-add-tag",
            "allow-mobile-remove-tag",
            "allow-mobile-toggle-pin",
            "allow-mobile-toggle-trash",
            "allow-mobile-get-tags",
            "allow-mobile-list-trashed",
            "allow-mobile-restore-trashed",
            "allow-mobile-capture-camera",
            "core:event:allow-listen",
            "core:event:allow-unlisten",
            "barcode-scanner:default"
          ]
        }
      ]
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "category": "Productivity",
    "copyright": "",
    "shortDescription": "Capture anything, organise it later."
  }
}