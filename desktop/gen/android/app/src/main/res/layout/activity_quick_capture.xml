<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher popup (QuickCaptureActivity): the phone's capture sheet drawn natively,
     over a dimmed view of whatever app was in front. Tapping the scrim dismisses it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/qcap_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/qcap_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/qcap_scrim"
        android:contentDescription="@null"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/qcap_sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/qcap_sheet_bg"
        android:clickable="true"
        android:focusable="false"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="10dp"
        android:paddingEnd="18dp"
        android:paddingBottom="16dp">

        <View
            android:layout_width="40dp"
            android:layout_height="5dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="6dp"
            android:background="@drawable/qcap_grab"
            android:importantForAccessibility="no" />

        <ImageView
            android:layout_width="56dp"
            android:layout_height="58dp"
            android:layout_gravity="center_horizontal"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/raven_mark" />

        <TextView
            android:id="@+id/qcap_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:letterSpacing="-0.03"
            android:textColor="@color/qcap_text"
            android:textSize="21sp" />

        <EditText
            android:id="@+id/qcap_field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/qcap_field_bg"
            android:gravity="top|start"
            android:hint="@string/quick_capture_hint"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences|textAutoCorrect"
            android:lineSpacingMultiplier="1.2"
            android:maxLines="8"
            android:minHeight="104dp"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="14dp"
            android:scrollbars="vertical"
            android:textColor="@color/qcap_text"
            android:textColorHint="@color/qcap_text_dim"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/qcap_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/qcap_danger"
            android:textSize="13sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/qcap_save"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/qcap_save_bg"
            android:fontFamily="sans-serif-medium"
            android:stateListAnimator="@null"
            android:text="@string/quick_capture_save"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp" />
    </LinearLayout>
</FrameLayout>
