<?xml version="1.0" encoding="utf-8"?>
<!--
  The app lock (BIO.1): a native cover over the whole window while Enqueue is locked.
  Native, not a page overlay, so it is up before the WebView paints its first frame and
  does not depend on the page booting. Same look as the quick-capture popup: the raven,
  one line, the violet primary button. The background colour is set in code so it
  follows the page ground (MainActivity.setGround).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/app_lock_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">

        <ImageView
            android:layout_width="84dp"
            android:layout_height="87dp"
            android:importantForAccessibility="no"
            android:src="@drawable/raven_mark" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/app_lock_title"
            android:textColor="@color/qcap_text"
            android:textSize="22sp" />

        <!-- AppCompatButton by name: under the Material theme a plain <Button> inflates
             as a MaterialButton, which ignores android:background and paints the theme's
             primary colour with wide letter-spacing instead of the app's violet. -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/app_lock_unlock"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/qcap_save_bg"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0"
            android:minWidth="160dp"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:stateListAnimator="@null"
            android:text="@string/app_lock_unlock"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp" />
    </LinearLayout>
</FrameLayout>
