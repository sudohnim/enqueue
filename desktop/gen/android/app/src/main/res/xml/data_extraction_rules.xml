<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing of Enqueue's leaves the phone through Android's own backup or its
     phone-to-phone transfer (Android 12+). The app's files hold the sync key and a
     readable copy of the library; the key is meant to reach a phone one way only,
     by scanning the code on the Mac, and a new phone is linked the same way. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
