<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      Light, not DayNight. Enqueue is a light-only surface by decision (DESIGN.md
      section 1, and the stylesheet pins `color-scheme: light`), so a DayNight parent only
      creates ways for the shell to disagree with the page: on a phone set to dark mode it
      painted the window background - now visible in the status and navigation bar strips
      the activity pads for - dark above a white app.

      windowBackground is pinned to the canvas token (#eee8f6, DESIGN.md section 2) so those
      strips match the page behind them, and the status bar icons stay dark against it.
    -->
    <style name="Theme.enqueue" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowBackground">@color/canvas</item>
    </style>

    <!--
      The launcher popup (QuickCaptureActivity): see-through, so the sheet floats over
      whatever app was in front instead of opening Enqueue. The activity draws its own
      scrim and lays itself out under the system bars and the keyboard.
    -->
    <style name="Theme.enqueue.QuickCapture" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.InputMethod</item>
    </style>
</resources>
