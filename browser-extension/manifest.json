{
  "manifest_version": 3,
  "name": "Enqueue",
  "short_name": "Enqueue",
  "version": "0.3.0",
  "description": "Save the page, a link, the words you picked or a picture into Enqueue on this Mac.",
  "icons": { "16": "icons/raven-16.png", "32": "icons/raven-32.png", "48": "icons/raven-48.png", "128": "icons/raven-128.png" },
  "action": { "default_title": "Save to Enqueue", "default_popup": "popup.html" },
  "background": { "service_worker": "background.js", "scripts": ["background.js"] },
  "permissions": ["activeTab", "contextMenus", "storage"],
  "host_permissions": ["http://127.0.0.1:8787/*"],
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+S" }, "description": "Save this page to Enqueue" }
  },
  "browser_specific_settings": { "gecko": { "id": "extension@enqueue.sudohnim.com", "strict_min_version": "121.0" } }
}
